# Configuration PentAGI pour ULTON AI (Sentinel)
# Port d'écoute de l'API PentAGI (par défaut interrogé par Ulton AI)
PENTAGI_PORT=8443

# Fournisseur LLM par défaut pour le cerveau PentAGI
LLM_PROVIDER=openai

# Renseignez au moins l'une de vos clés API LLM :
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Pour utiliser un modèle Ollama local sans clé API :
OLLAMA_BASE_URL=http://host.docker.internal:11434
