# Production environment variables template (copy to .env or set in Render / hosting dashboard)

# --- Application & URL ---
PUBLIC_URL=https://votre-domaine.com
SECRET_KEY=remplacez-par-une-cle-aleatoire-de-64-caracteres
PORT=10000

# --- Persistent storage paths (defaults to ./data and ./cloned_sites if unset) ---
# DATA_DIR=/var/data
# CLONED_DIR=/var/data/cloned_sites

# --- Private Admin Dashboard (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=choisissez-un-mot-de-passe-robuste

# --- Stripe & Stripe Connect Express (99% seller / 1% platform fee) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SHOP_CURRENCY=eur

# --- SMTP (required to email 7-day download links to Marketplace buyers) ---
SMTP_HOST=smtp.exemple.com
SMTP_PORT=587
SMTP_USER=contact@votre-domaine.com
SMTP_PASSWORD=mot-de-passe-smtp
SMTP_FROM=SiteCloner Marketplace <contact@votre-domaine.com>
